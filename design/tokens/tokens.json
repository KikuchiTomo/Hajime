{
  "$description": "s90.tokyo IME のデザイントークン．Swift・Rust・CSS のコードは tools/tokens がここから生成する．形式は Design Tokens Community Group の仕様に従う",
  "theme": {
    "platinum": {
      "color": {
        "surface": { "$type": "color", "$value": "#DDDDDD" },
        "bevel-light": { "$type": "color", "$value": "#FFFFFF" },
        "bevel-shadow": { "$type": "color", "$value": "#999999" },
        "frame": { "$type": "color", "$value": "#000000" },
        "text": { "$type": "color", "$value": "#000000" },
        "text-muted": { "$type": "color", "$value": "#555555" },
        "selection": { "$type": "color", "$value": "#336699" },
        "selection-text": { "$type": "color", "$value": "#FFFFFF" },
        "correction": { "$type": "color", "$value": "#CC3366" },
        "prediction": { "$type": "color", "$value": "#666666" }
      }
    },
    "desk": {
      "color": {
        "surface": { "$type": "color", "$value": "#220044" },
        "bevel-light": { "$type": "color", "$value": "#442277" },
        "bevel-shadow": { "$type": "color", "$value": "#110022" },
        "frame": { "$type": "color", "$value": "#000000" },
        "text": { "$type": "color", "$value": "#FFCC66" },
        "text-muted": { "$type": "color", "$value": "#9977BB" },
        "selection": { "$type": "color", "$value": "#FF3399" },
        "selection-text": { "$type": "color", "$value": "#220044" },
        "correction": { "$type": "color", "$value": "#33FFCC" },
        "prediction": { "$type": "color", "$value": "#9977BB" }
      }
    }
  },
  "size": {
    "candidate": {
      "row-height": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
      "font-size": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
      "font-size-min": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "font-size-max": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "index-width": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
      "padding-x": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "frame-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "bevel-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "max-visible": { "$type": "number", "$value": 9 }
    }
  },
  "motion": {
    "mode-indicator": {
      "visible": { "$type": "duration", "$value": { "value": 800, "unit": "ms" } },
      "fade": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } }
    },
    "correction-underline": {
      "appear": { "$type": "duration", "$value": { "value": 80, "unit": "ms" } }
    }
  },
  "$extensions": {
    "s90": {
      "contrast": [
        { "theme": "platinum", "fg": "text", "bg": "surface", "min": 4.5 },
        { "theme": "platinum", "fg": "text-muted", "bg": "surface", "min": 4.5 },
        { "theme": "platinum", "fg": "selection-text", "bg": "selection", "min": 4.5 },
        { "theme": "platinum", "fg": "correction", "bg": "surface", "min": 3 },
        { "theme": "platinum", "fg": "prediction", "bg": "surface", "min": 3 },
        { "theme": "desk", "fg": "text", "bg": "surface", "min": 4.5 },
        { "theme": "desk", "fg": "text-muted", "bg": "surface", "min": 4.5 },
        { "theme": "desk", "fg": "selection-text", "bg": "selection", "min": 4.5 },
        { "theme": "desk", "fg": "correction", "bg": "surface", "min": 3 },
        { "theme": "desk", "fg": "prediction", "bg": "surface", "min": 3 }
      ]
    }
  }
}
