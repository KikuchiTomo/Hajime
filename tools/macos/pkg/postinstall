#!/bin/sh
# 入れたあとはログアウトを求める(distribution.xml の RequireLogout)．ログインし直すと OS が新しい本体を読む．
# ログイン中の利用者の入力ソースに登録して有効にしておき，ログインし直したときに入力メニューに出るようにする．
# 誰もログインしていなければ(コマンドで入れたときなど)何もしない．次のログインで OS が見つける
app="$2/Hajime.app"
user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ] && [ -d "$app" ]; then
  uid=$(id -u "$user")
  # インストーラーのスクリプトの置き場所と root の一時フォルダ(TMPDIR)は利用者が入れないので，誰でも入れる /private/tmp に写して動かす
  tool_dir=$(mktemp -d /private/tmp/hajime.XXXXXX)
  cp "$(dirname "$0")/input_source" "$tool_dir/input_source"
  chmod 755 "$tool_dir" "$tool_dir/input_source"
  launchctl asuser "$uid" sudo -u "$user" "$tool_dir/input_source" enable "$app" || true
  rm -rf "$tool_dir"
fi
exit 0
