{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hajime-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
