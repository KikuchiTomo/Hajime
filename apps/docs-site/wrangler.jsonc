{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hajime-site",
  "compatibility_date": "2026-10-01",
  // /download/ の下だけ Worker で R2 の配布物を配る．ほかは静的アセット
  "main": "./worker/downloads.js",
  "no_bundle": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/download/*"]
  },
  // 配布物の置き場所．tools/release/upload_downloads.sh もこの名前を読む
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "hajime-downloads"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
