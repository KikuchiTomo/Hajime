<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Hajime IME" Manufacturer="haji.men" Version="$(Version)" UpgradeCode="08481E5D-EF2E-4129-9B02-0DB3228DF9D5" Scope="perMachine" Language="1041" Codepage="932">
    <!-- 同じ版でも上書きできるようにする(試しに入れた版の上から入れ直すとき) -->
    <!-- 古い版は，新しい版を入れ終えてから消す(afterInstallExecute)．TSF の DLL の部品は版によらず同じ GUID なので，古い版を消すときに
         その部品は新しい版が使っていることになり，古い版の DLL を Windows Installer が消さない(消そうとすると，ほぼすべてのアプリが読み込んでいて
         「アプリを終了する必要があります」の窓が出る)．古い版のフォルダは RemoveOldVersions が消す(消せないファイルは再起動で消す) -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute" DowngradeErrorMessage="新しいバージョンの Hajime IME がインストール済みです。" />
    <MediaTemplate EmbedCab="yes" />
    <!-- 上書きのときに，TSF の DLL を読み込んでいるアプリ(ほぼすべてのアプリ)を閉じさせない．
         古い DLL は読み込まれたまま残り，次の再起動で消える(下の TSFVERSIONFOLDER の説明) -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hajime">
        <!-- TSF の DLL はバージョンごとのフォルダに置く(tsf\<バージョン>\)．動いているアプリが前のバージョンの DLL を
             読み込んでいても場所が重ならないので，置き換えを待たずに新しい DLL を登録でき，上書きで再起動が要らない．
             インストール先を DLL の場所から求める処理は apps/windows/crates/tsf/src/install.rs -->
        <Directory Id="TSFFOLDER" Name="tsf">
          <Directory Id="TSFVERSIONFOLDER" Name="$(Version)">
            <Directory Id="TSFX86FOLDER" Name="x86" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(StageDir)\**">
        <Exclude Files="$(StageDir)\hajime_tsf.dll" />
        <Exclude Files="$(StageDir)\x86\hajime_tsf.dll" />
      </Files>
      <ComponentRef Id="TextService64" />
      <ComponentRef Id="TextService32" />
      <ComponentRef Id="Autostart" />
      <ComponentRef Id="SettingsShortcut" />
      <ComponentRef Id="SetupWizard" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="SettingsShortcut" Guid="E72997F4-1CBF-4197-9A65-1B1CC20FA1E2">
        <Shortcut Id="SettingsShortcut" Name="Hajime IME の設定" Target="[INSTALLFOLDER]hajime-settings.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\haji.men\IME" Name="SettingsShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- GUID は版によらず同じにする(上の MajorUpgrade の説明) -->
    <Component Id="TextService64" Directory="TSFVERSIONFOLDER" Guid="3A6F2C1D-8E4B-4F7A-9C25-6B1D0E8F4A73">
      <File Id="TextService64" Source="$(StageDir)\hajime_tsf.dll" />
    </Component>
    <Component Id="TextService32" Directory="TSFX86FOLDER" Guid="7C2E5B94-1D3F-4A86-B0E7-2F9A6C4D8E15">
      <File Id="TextService32" Source="$(StageDir)\x86\hajime_tsf.dll" />
    </Component>

    <Component Id="Autostart" Directory="INSTALLFOLDER" Guid="5F0B6C1E-6A43-4C1F-9C55-1E7A4E2B9D31">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Hajime" Type="string" Value="&quot;[INSTALLFOLDER]hajime-engine-host.exe&quot;" KeyPath="yes" />
    </Component>

    <!-- ログオンのたびに初期設定ウィザードを起動する．済んでいれば(HKCU の SetupCompleted)すぐに終わる -->
    <Component Id="SetupWizard" Directory="INSTALLFOLDER" Guid="B3E1F0A2-7C4D-4E8B-9A61-2D5C8F7E3A14">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Hajime Setup" Type="string" Value="&quot;[INSTALLFOLDER]hajime-settings.exe&quot; --setup-if-needed" KeyPath="yes" />
    </Component>

    <CustomAction Id="Register64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Register32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[TSFX86FOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Unregister64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="Unregister32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s /u &quot;[TSFX86FOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- 上書き(アップデート)・削除の前に，動いているエンジン・候補ウィンドウ・設定の画面を止める．止めないと古い版が動き続け，
         入れたあとに起動する新しいエンジンは「もう動いている」とすぐ終わるので，古い版と新しい DLL が混ざる(候補ウィンドウが出ない)．
         利用者のプロセスなので，利用者の権限で InstallValidate(使っているファイルを調べる)の前に止める -->
    <CustomAction Id="StopRunning" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM hajime-engine-host.exe /IM hajime-candidate-ui.exe /IM hajime-settings.exe" Execute="immediate" Impersonate="yes" Return="ignore" />
    <!-- 入れたあと，日本語の既定の入力方式が Hajime IME なら，このセッションの入力方式を Hajime IME に戻す(今出ている版から上書きすると，
         古い版を消すときに登録が一度外れ，Windows がほかの入力方式に替えるため)．利用者の権限で呼ぶ．失敗しても入れる処理は止めない -->
    <CustomAction Id="RestoreProfile" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]rundll32.exe&quot; &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;,RestoreProfile" Execute="immediate" Impersonate="yes" Return="ignore" />
    <!-- 古い版を消したあと(RemoveExistingProducts)に，新しい版の登録をし直す．v0.3.3 までの版は，上書きで消されるときも登録を外すので，
         新しい版を先に入れる順では，新しい版の登録が外れたままになる -->
    <CustomAction Id="Reregister64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Reregister32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[TSFX86FOLDER]hajime_tsf.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <!-- 前の版の DLL のフォルダ(tsf\<前のバージョン>)を消す．消せないファイルは再起動で消す．管理者の権限で呼ぶ．失敗しても止めない -->
    <CustomAction Id="RemoveOldVersions" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]rundll32.exe&quot; &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;,RemoveOldVersions" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveOldVersionsOnRemove" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]rundll32.exe&quot; &quot;[TSFVERSIONFOLDER]hajime_tsf.dll&quot;,RemoveOldVersions" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="StartEngine" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]hajime-engine-host.exe&quot;" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="StopRunning" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <!-- 上書きで古い版を消すとき(UPGRADINGPRODUCTCODE)は登録を外さない．外すとそのあいだに Windows がこのセッションの入力方式を
           ほかのものに替え，入れ終わっても戻さない．CLSID とプロファイルは版によらず同じなので，新しい版の Register が場所を書き換える -->
      <Custom Action="Unregister64" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="Unregister32" After="Unregister64" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="Register64" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="Register32" After="Register64" Condition="NOT REMOVE" />
      <Custom Action="Reregister64" After="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="Reregister32" After="Reregister64" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="RemoveOldVersions" After="Reregister32" Condition="NOT REMOVE" />
      <!-- 消すとき(上書きでないとき)も，前の版のフォルダを消す(今の版のフォルダは Windows Installer が消す) -->
      <Custom Action="RemoveOldVersionsOnRemove" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StartEngine" After="InstallFinalize" Condition="NOT REMOVE" />
      <!-- 入れたあと(初めて入れたときも上書きのときも)，Windows Installer の標準の確認で再起動を求める．
           起動中のアプリには新しい文字入力のサービスが読み込まれないので，再起動してから使う -->
      <Custom Action="RestoreProfile" After="StartEngine" Condition="NOT REMOVE" />
      <ScheduleReboot After="RestoreProfile" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
